SELECT COUNT(*) AS sem_pagamento FROM fato_contas_receber
WHERE  sk_tempo_pagamento = -1;                                       -- 5
SELECT f.num_titulo,
       te.data_completa      AS emissao,
       c.nome,
       c.categoria           AS categoria_na_epoca,
       hoje.categoria        AS categoria_hoje
FROM   fato_contas_receber f
JOIN   dim_cliente c    ON c.sk_cliente = f.sk_cliente
JOIN   dim_tempo   te   ON te.sk_tempo  = f.sk_tempo_emissao
JOIN   dim_cliente hoje ON hoje.cod_cliente = c.cod_cliente
                       AND hoje.atual = 'S'
ORDER  BY f.num_titulo;
