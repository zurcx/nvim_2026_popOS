CREATE TABLE silver_jogadores(
  id_jogador INT NOT NULL,
  nomeVARCHAR(100) NOT NULL,
  clubeVARCHAR(50) NOT NULL,
  posicaoVARCHAR(30),
  gols INT NOT NULL DEFAULT 0,
  partidas_jogadas INT NOT NULL DEFAULT 0,
  media_gols_por_partidaDECIMAL(
    5,
    2
  ),
  classificacao_artilheiroVARCHAR(20) CONSTRAINT pk_jogador PRIMARY KEY(id_jogador),
  CONSTRAINT chk_gols_nao_negativo CHECK(gols >= 0),
  CONSTRAINT chk_partidas_nao_negativo CHECK(partidas_jogadas >= 0)
);
