-- 2.2

CREATE VIEW vw_funcionarios AS
SELECT
    f.matricula,
    f.nome,
    f.cargo,
    d.nome_certo AS departamento,
    CASE WHEN f.gestor = '' THEN NULL ELSE f.gestor END AS gestor,
    STR_TO_DATE(f.dt_admissao, '%d/%m/%Y') AS dt_admissao,
    STR_TO_DATE(NULLIF(f.dt_desligamento,''), '%d/%m/%Y') AS dt_desligamento,
    CASE WHEN f.motivo_saida = '' THEN NULL ELSE f.motivo_saida END AS motivo_saida,
    CAST(REPLACE(REPLACE(f.salario,'.',''),',','.') AS DECIMAL(10,2)) AS salario,
    f.nivel,
    CASE WHEN f.genero IN ('F','Fem') THEN 'Feminino' ELSE 'Masculino' END AS genero
FROM      stg_funcionarios     f
LEFT JOIN de_para_departamento d ON d.valor_bruto = f.departamento;

SELECT * FROM vw_funcionarios;

