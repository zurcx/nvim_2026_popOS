CREATE TABLE dim_funcionario (
    sk_funcionario   INT AUTO_INCREMENT PRIMARY KEY,
    matricula        VARCHAR(10),
    nome             VARCHAR(60),
    cargo            VARCHAR(50),
    nivel            VARCHAR(20),
    genero           VARCHAR(15),
    sk_departamento  INT,
    sk_gestor        INT,
    dt_admissao      DATE,
    dt_desligamento  DATE,
    salario          DECIMAL(10,2),
    ativo            VARCHAR(1),
    FOREIGN KEY (sk_departamento) REFERENCES dim_departamento(sk_departamento)
);


-- 4.1 primeiro todo mundo entra, ainda sem gestor

INSERT INTO dim_funcionario
    (matricula, nome, cargo, nivel, genero, sk_departamento,
     sk_gestor, dt_admissao, dt_desligamento, salario, ativo)
SELECT f.matricula, f.nome, f.cargo, f.nivel, f.genero, d.sk_departamento,
       NULL, f.dt_admissao, f.dt_desligamento, f.salario,
       CASE WHEN f.dt_desligamento IS NULL THEN 'S' ELSE 'N' END
FROM   vw_funcionarios  f
JOIN   dim_departamento d ON d.nome = f.departamento
ORDER  BY f.matricula;


-- 4.2 so DEPOIS da para resolver o gestor: ele so tem chave agora

UPDATE dim_funcionario d
JOIN   vw_funcionarios v ON v.matricula = d.matricula
JOIN   dim_funcionario g ON g.matricula = v.gestor
SET    d.sk_gestor = g.sk_funcionario;

SELECT sk_funcionario, matricula, nome, sk_gestor, ativo FROM dim_funcionario;


CREATE TABLE bridge_projeto (
    sk_funcionario  INT,
    sk_projeto      INT,
    fator           DECIMAL(5,2),
    PRIMARY KEY (sk_funcionario, sk_projeto),
    FOREIGN KEY (sk_funcionario) REFERENCES dim_funcionario(sk_funcionario),
    FOREIGN KEY (sk_projeto)     REFERENCES dim_projeto(sk_projeto)
);

INSERT INTO bridge_projeto
SELECT f.sk_funcionario, p.sk_projeto, a.fator
FROM   vw_alocacao     a
JOIN   dim_funcionario f ON f.matricula = a.matricula
JOIN   dim_projeto     p ON p.nome      = a.projeto;

-- teste obrigatorio: a soma dos fatores de cada pessoa tem que dar 1

SELECT f.nome, SUM(b.fator) AS soma
FROM   bridge_projeto b
JOIN   dim_funcionario f ON f.sk_funcionario = b.sk_funcionario
GROUP  BY f.nome
HAVING SUM(b.fator) <> 1;


SELECT * FROM bridge_projeto;

CREATE TABLE fato_headcount (
    sk_mes           INT,
    sk_funcionario   INT,
    sk_departamento  INT,
    salario          DECIMAL(10,2),
    ativo            INT,
    PRIMARY KEY (sk_mes, sk_funcionario),
    FOREIGN KEY (sk_mes)          REFERENCES dim_mes(sk_mes),
    FOREIGN KEY (sk_funcionario)  REFERENCES dim_funcionario(sk_funcionario),
    FOREIGN KEY (sk_departamento) REFERENCES dim_departamento(sk_departamento)
);

-- Quem estava ativo no ultimo dia de cada mes de 2025 (janeiro a agosto)?

INSERT INTO fato_headcount
SELECT m.sk_mes, f.sk_funcionario, f.sk_departamento, f.salario, 1
FROM   dim_mes m
JOIN   dim_funcionario f ON f.dt_admissao <= m.ultimo_dia
                        AND (f.dt_desligamento IS NULL OR f.dt_desligamento >= m.ultimo_dia)
WHERE  m.sk_mes BETWEEN 202501 AND 202508;

SELECT m.ano_mes, SUM(h.ativo) AS headcount
FROM   fato_headcount h
JOIN   dim_mes m ON m.sk_mes = h.sk_mes
GROUP  BY m.ano_mes ORDER BY m.ano_mes;


CREATE TABLE bridge_organograma (
    sk_superior     INT,
    sk_subordinado  INT,
    niveis          INT,
    PRIMARY KEY (sk_superior, sk_subordinado)
);

-- nivel 0: cada pessoa e superior de si mesma

INSERT INTO bridge_organograma
SELECT sk_funcionario, sk_funcionario, 0 FROM dim_funcionario;

-- nivel 1: o gestor direto

INSERT INTO bridge_organograma
SELECT f.sk_gestor, f.sk_funcionario, 1
FROM   dim_funcionario f
WHERE  f.sk_gestor IS NOT NULL;

-- nivel 2: o gestor do gestor

INSERT INTO bridge_organograma
SELECT g.sk_gestor, f.sk_funcionario, 2
FROM   dim_funcionario f
JOIN   dim_funcionario g ON g.sk_funcionario = f.sk_gestor
WHERE  g.sk_gestor IS NOT NULL;

-- nivel 3
 
INSERT INTO bridge_organograma
SELECT g2.sk_gestor, f.sk_funcionario, 3
FROM   dim_funcionario f
JOIN   dim_funcionario g1 ON g1.sk_funcionario = f.sk_gestor
JOIN   dim_funcionario g2 ON g2.sk_funcionario = g1.sk_gestor
WHERE  g2.sk_gestor IS NOT NULL;

-- nivel 4
INSERT INTO bridge_organograma
SELECT g3.sk_gestor, f.sk_funcionario, 4
FROM   dim_funcionario f
JOIN   dim_funcionario g1 ON g1.sk_funcionario = f.sk_gestor
JOIN   dim_funcionario g2 ON g2.sk_funcionario = g1.sk_gestor
JOIN   dim_funcionario g3 ON g3.sk_funcionario = g2.sk_gestor
WHERE  g3.sk_gestor IS NOT NULL;

SELECT COUNT(*) AS pares FROM bridge_organograma;   -- 29
