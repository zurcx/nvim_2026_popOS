CREATE TABLE fato_contas_receber (
    num_titulo           VARCHAR(15) PRIMARY KEY,
    nota_fiscal          VARCHAR(15),
    sk_cliente           INT,
    sk_tempo_emissao     INT,
    sk_tempo_vencimento  INT,
    sk_tempo_pagamento   INT,
    sk_perfil            INT,
    sk_status            INT,
    valor_original       DECIMAL(10,2),
    valor_pago           DECIMAL(10,2),
    valor_em_aberto      DECIMAL(10,2),
    dias_atraso          INT,
    inadimplente         INT,
    qtd_titulo           INT,
    FOREIGN KEY (sk_cliente)          REFERENCES dim_cliente(sk_cliente),
    FOREIGN KEY (sk_tempo_emissao)    REFERENCES dim_tempo(sk_tempo),
    FOREIGN KEY (sk_tempo_vencimento) REFERENCES dim_tempo(sk_tempo),
    FOREIGN KEY (sk_tempo_pagamento)  REFERENCES dim_tempo(sk_tempo),
    FOREIGN KEY (sk_perfil)           REFERENCES dim_perfil(sk_perfil),
    FOREIGN KEY (sk_status)           REFERENCES dim_status(sk_status)
);

INSERT INTO fato_contas_receber
SELECT
    v.num_titulo,
    v.nota_fiscal,
    c.sk_cliente,
    te.sk_tempo,
    tv.sk_tempo,
    IFNULL(tp.sk_tempo, -1),
    p.sk_perfil,
    s.sk_status,
    v.valor_original,
    v.valor_pago,
    v.valor_em_aberto,
    v.dias_atraso,
    v.inadimplente,
    1
FROM      vw_titulos_calc v

-- >>> O JOIN QUE RESOLVE O PROBLEMA DO RODRIGO <<<
-- nao basta casar o codigo do cliente: tem que casar tambem a DATA
JOIN      dim_cliente c  ON c.cod_cliente = v.cod_cliente
                        AND v.dt_emissao BETWEEN c.inicio_validade AND c.fim_validade

JOIN      dim_tempo   te ON te.data_completa = v.dt_emissao
JOIN      dim_tempo   tv ON tv.data_completa = v.dt_vencimento
LEFT JOIN dim_tempo   tp ON tp.data_completa = v.dt_pagamento
JOIN      dim_perfil  p  ON p.forma_cobranca = v.forma_cobranca
                        AND p.canal_venda    = v.canal_venda
                        AND p.recorrente     = v.recorrente
JOIN      dim_status  s  ON s.status = v.status;

