DROP TABLE IF EXISTS raw_vendas;
CREATE TABLE raw_vendas (
    id_registro      INT AUTO_INCREMENT,
    id_pedido        INT             NOT NULL,
    data_pedido      VARCHAR(10)     NOT NULL,           -- texto: 'AAAA-MM-DD'
    id_cliente       INT             NOT NULL,
    nome_cliente     VARCHAR(100)    NOT NULL,
    estado           CHAR(2)         NOT NULL,
    cidade           VARCHAR(100)    NOT NULL,
    id_produto       VARCHAR(10)     NOT NULL,
    nome_produto     VARCHAR(100)    NOT NULL,
    categoria        VARCHAR(5 0)     NOT NULL,
    quantidade       INT             NOT NULL,
    preco_unitario   DECIMAL(10,2)   NOT NULL,
    custo_unitario   DECIMAL(10,2)   NOT NULL,
    forma_pagamento  VARCHAR(40)     NOT NULL,
    CONSTRAINT pk_raw            PRIMARY KEY (id_registro),
    CONSTRAINT uq_raw_item       UNIQUE (id_pedido, id_produto),
    CONSTRAINT ck_raw_qtd        CHECK (quantidade > 0),
    CONSTRAINT ck_raw_preco      CHECK (preco_unitario >= 0),
    CONSTRAINT ck_raw_custo      CHECK (custo_unitario >= 0)
);

