CREATE VIEW vw_titulos AS
SELECT
    num_titulo,
    nota_fiscal,
    cod_cliente,
    STR_TO_DATE(dt_emissao   , '%d/%m/%Y') AS dt_emissao,
    STR_TO_DATE(dt_vencimento, '%d/%m/%Y') AS dt_vencimento,
    -- NULLIF troca a data em branco por NULL ANTES de tentar converter
    STR_TO_DATE(NULLIF(dt_pagamento,''), '%d/%m/%Y') AS dt_pagamento,
    CAST(REPLACE(REPLACE(valor_original,'.',''),',','.') AS DECIMAL(10,2)) AS valor_original,
    CAST(REPLACE(REPLACE(valor_pago    ,'.',''),',','.') AS DECIMAL(10,2)) AS valor_pago,
    CAST(REPLACE(REPLACE(juros_multa   ,'.',''),',','.') AS DECIMAL(10,2)) AS juros_multa,
    CAST(REPLACE(REPLACE(desconto      ,'.',''),',','.') AS DECIMAL(10,2)) AS desconto,
    forma_cobranca,
    canal_venda,
    CASE WHEN recorrente IN ('S','Sim') THEN 'Sim' ELSE 'Não' END AS recorrente
FROM stg_titulos;


CREATE VIEW vw_titulos_calc AS
SELECT
    t.*,
    valor_original - valor_pago + juros_multa - desconto AS valor_em_aberto,
    DATEDIFF(IFNULL(dt_pagamento, '2025-08-31'), dt_vencimento) AS dias_atraso,
    CASE WHEN dt_pagamento IS NULL AND dt_vencimento < '2025-08-31'
         THEN 1 ELSE 0 END AS inadimplente,
    CASE WHEN dt_pagamento IS NULL AND dt_vencimento < '2025-08-31' THEN 'Em atraso'
         WHEN dt_pagamento IS NULL                                  THEN 'A vencer'
         WHEN dt_pagamento <  dt_vencimento                         THEN 'Pago antecipado'
         WHEN dt_pagamento =  dt_vencimento                         THEN 'Pago em dia'
         ELSE 'Pago com atraso'
    END AS status
FROM vw_titulos t;

