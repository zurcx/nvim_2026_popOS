SELECT matricula,
       cargo_anterior,
       cargo_novo,
       CAST(REPLACE(REPLACE(salario_anterior,'.',''),',','.') AS DECIMAL(10,2)) AS salario_anterior,
       CAST(REPLACE(REPLACE(salario_novo    ,'.',''),',','.') AS DECIMAL(10,2)) AS salario_novo,
       STR_TO_DATE(data_promocao, '%d/%m/%Y') AS dt_promocao
FROM   stg_promocoes;


